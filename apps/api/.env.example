# =============================================================================
# Luxus Green Mobility API — environment reference
# -----------------------------------------------------------------------------
# Copy to .env and fill in. The process validates this file at BOOT and exits
# with a clear message if anything required is missing or too weak, so a
# misconfigured deploy fails immediately instead of at the first login.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Pooled connection (pgbouncer, port 6543 on Supabase) — used for all queries.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used ONLY by `prisma db push` / migrate,
# because pgbouncer's transaction pooling can't run the schema engine's DDL.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Session signing keys. Both are REQUIRED — the process refuses to start
# without them. Use at least 32 characters in production; a shorter one only
# logs a warning rather than blocking the boot. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# These are two SEPARATE trust domains (staff vs dealer). Never reuse one key
# for both: a leak of either would otherwise let a dealer mint a staff session.
JWT_SECRET=
JWT_DEALER_SECRET=

# --- Deployment --------------------------------------------------------------

NODE_ENV=production
PORT=4000

# Worker processes. Leave unset and the app follows WEB_CONCURRENCY, which
# Render and Heroku set from the instance's actual CPU/memory allocation;
# with neither set it runs a single worker.
#
# Don't raise this past what the instance can hold: each worker is a full copy
# of the app plus its own database pool, so over-forking a small container
# trades a working service for an out-of-memory crash loop. Raise the instance
# size first, then this.
# CLUSTER_WORKERS=2

# Number of reverse proxies in front of this app, for correct client IPs in
# rate limiting. Render/Railway/Fly = 1. Cloudflare in front of those = 2.
# Do NOT set this to "true": blanket trust lets a client forge X-Forwarded-For
# and evade the rate limiter entirely.
TRUST_PROXY=1

# --- CORS --------------------------------------------------------------------
# Comma-separated allowlist of browser origins permitted to send credentialed
# requests. Unlisted origins are refused, not reflected. No trailing slashes.
CORS_ORIGINS=https://crm.example.com,https://apply.example.com,https://dms.example.com
# Or, if you prefer them individually (ignored when CORS_ORIGINS is set):
# WEB_ORIGIN=http://localhost:3000
# LANDING_ORIGIN=http://localhost:3001
# DMS_ORIGIN=http://localhost:3002

# --- Security switches -------------------------------------------------------

# The built-in Admin / Admin@123 account in auth.controller.ts. It exists so
# the CRM can be demonstrated even when the database is paused, and it is a
# SYSTEM_ADMIN password published in the source tree.
#
#   Defaults to ON outside production and OFF in production.
#
# Set to true ONLY for a demo environment holding no real data. Switching it
# back off also invalidates any demo session already issued.
ENABLE_DEMO_LOGIN=false
# Override the demo credentials if you do enable it.
# DEMO_USERNAME=Admin
# DEMO_PASSWORD=

# Trust `x-user-role` / `x-user-id` headers instead of a session — for local
# curl/Postman work only. Forced off whenever NODE_ENV=production, regardless
# of this value.
ALLOW_HEADER_AUTH=false

# --- Database pool -----------------------------------------------------------
# Connections PER WORKER. Total load on the database is
# CLUSTER_WORKERS x DB_CONNECTION_LIMIT x (number of instances) — keep that
# product comfortably under the pooler's client limit.
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=10

# --- Rate limiting -----------------------------------------------------------
# Per IP, per window. Generous by design: this is a denial-of-service guard,
# not a business quota.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
# Login/signup: keyed by IP + username, and successful logins don't count.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Timeouts (milliseconds) -------------------------------------------------
# KEEP_ALIVE_TIMEOUT_MS must be GREATER than your load balancer's idle timeout,
# or you will see intermittent 502s under load that are impossible to
# reproduce locally. Render's is 60s, hence 65s here.
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=70000
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=15000

# --- Limits ------------------------------------------------------------------
MAX_JSON_BODY_BYTES=1000000
MAX_UPLOAD_BYTES=10485760

# --- Observability -----------------------------------------------------------
LOG_LEVEL=info
# Any single database query slower than this is logged with its duration.
SLOW_QUERY_MS=500

# --- Integrations ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# HMAC secret for the public landing-page webhook. Leave unset to accept
# unsigned posts (development only).
INGEST_WEBHOOK_SECRET=
